# PayPilot Environment Variables
# AI Studio automatically injects Secrets configured via the Settings > Secrets panel.

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected automatically in AI Studio).
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase PostgreSQL connection string.
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="MY_DATABASE_URL"

# PAYPAL_CLIENT_ID: PayPal Developer Sandbox App Client ID.
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: PayPal Developer Sandbox App Secret.
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"

# PAYPAL_BASE_URL: Defaults to Sandbox endpoint.
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
